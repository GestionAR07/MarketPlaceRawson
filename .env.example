# Marketplace Rawson — environment variables (example)
#
# Copy this file to `.env.local` for local development:
#   copy .env.example .env.local
#
# Never commit `.env.local` or real secrets.
#
# DEV and PROD must be different Supabase projects (Postgres, Auth, Storage).
# Same variable names; different values. Production values live only in hosting,
# never in this file and never in a developer `.env.local`.
# See docs/OPERATIONS.md.

# -----------------------------------------------------------------------------
# App public origin (server-side) — invitations and auth redirects
# -----------------------------------------------------------------------------
# Absolute origin of this Next.js app. Used when building invite links.
# Local development for this project often uses port 3001 (3000 may be taken):
#   APP_BASE_URL=http://localhost:3001
# Production should use https://…
APP_BASE_URL=

# -----------------------------------------------------------------------------
# Database (server-only) — Drizzle / postgres.js
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Supabase pooler or direct).
# Used by Drizzle migrate and server-side getDb() only.
# NEVER expose as NEXT_PUBLIC_*.
#
# Example shape (replace with your dev project values; do not commit real secrets):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase Auth (browser + server via publishable key)
# -----------------------------------------------------------------------------
# Project URL and publishable (anon) key from Supabase Dashboard → Settings → API.
# These are safe to ship to the browser. Never put secret/service keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show Google login only after the Google provider is configured in both
# Google Auth Platform and Supabase Auth → Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# -----------------------------------------------------------------------------
# Supabase secret key (server-only) — Auth Admin API
# -----------------------------------------------------------------------------
# Used exclusively for server-side Auth Admin operations (locate users, invite).
# NEVER expose as NEXT_PUBLIC_SUPABASE_SECRET_KEY.
# NEVER import/use this in Client Components.
# Real value lives only in .env.local / secure hosting secrets.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Runtime environment selection (not a secret)
# -----------------------------------------------------------------------------
# Selects which identity rules apply. NODE_ENV does not choose the Supabase
# project. Leave empty for local `next dev`. A serving production process
# (NODE_ENV=production, not `next build`) must set this explicitly to
# production. NEXT_PHASE is only a Next.js build discriminator.
MARKETPLACE_ENV=

# -----------------------------------------------------------------------------
# Authorized DEV identity for manual mutation harnesses
# -----------------------------------------------------------------------------
# Exact Supabase project ref of the authorized DEV project
# (the subdomain of https://<ref>.supabase.co).
# Shared by scripts/validate-real-order-lifecycle.ts and E2E WRITE_DEV.
# No fallback. Never commit the real value.
MARKETPLACE_DEV_PROJECT_REF=

# Expected Supabase project ref when MARKETPLACE_ENV=production.
# Not a secret. Used only by the runtime environment guard.
# Must be different from MARKETPLACE_DEV_PROJECT_REF.
# Leave empty locally. Set the real value only in production hosting.
# DEV placeholder: <dev-project-ref>
# PROD placeholder: <prod-project-ref>
# The two refs must be different.
MARKETPLACE_PROD_PROJECT_REF=

# -----------------------------------------------------------------------------
# Playwright WRITE_DEV (manual/local only)
# -----------------------------------------------------------------------------
# `npm run e2e` remains READ_ONLY and ignores these credentials for its server.
# `npm run e2e:dev` sets E2E_MODE=WRITE_DEV itself, but it still refuses to
# start a write-capable server unless this second confirmation matches exactly:
#   E2E_ALLOW_WRITES=I_ACCEPT_E2E_DEV_WRITES
# Keep blank by default. Never configure this in normal CI.
E2E_ALLOW_WRITES=
